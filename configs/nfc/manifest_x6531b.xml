<manifest version="4.0" type="device" target-level="6">
    <!-- X6531B: TMS/THN31 NFC.  The prebuilt HIDL HALs
         (vendor/infinix/X6531/proprietary_x6531b, packaged by
         vendor/infinix/X6531/X6531B-nfc.mk) register themselves here:
         android.hardware.nfc@1.2::INfc/default is the interface
         packages/modules/Nfc's libnfc-nci looks up first, the vendor.tms
         extension carries the TMS specific commands, and the MTK SIM/eUICC
         Secure Element HAL is what com.android.se enumerates (without it
         the NFC stack's SE discovery fails on every enable).
         Only installed for lineage_X6531B - see the NFC block in device.mk. -->
    <hal format="hidl">
        <name>android.hardware.nfc</name>
        <transport>hwbinder</transport>
        <fqname>@1.2::INfc/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.tms.tmsnfc</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::ITmsNfc/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.secure_element</name>
        <transport>hwbinder</transport>
        <fqname>@1.2::ISecureElement/SIM1</fqname>
        <fqname>@1.2::ISecureElement/SIM2</fqname>
    </hal>
</manifest>
