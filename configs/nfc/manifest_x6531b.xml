<manifest version="4.0" type="device" target-level="6">
        <!-- X6531B: TMS/THN31 NFC + MTK SIM Secure Element (vendor.tms.hardware.nfc.xml). -->
    <hal format="hidl">
        <name>android.hardware.nfc</name>
        <transport>hwbinder</transport>
        <fqname>@1.2::INfc/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.tms.tmsnfc</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::ITmsNfc/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.secure_element</name>
        <transport>hwbinder</transport>
        <fqname>@1.2::ISecureElement/SIM1</fqname>
        <fqname>@1.2::ISecureElement/SIM2</fqname>
    </hal>
</manifest>
